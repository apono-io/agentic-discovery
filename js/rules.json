    },
    {
      "keys": [
        "schema"
      ],
      "type": "db-schema"
    },
    {
      "keys": [
        "table",
        "table_name"
      ],
      "type": "db-table"
    },
    {
      "keys": [
        "warehouse"
      ],
      "type": "db-warehouse"
    },
    {
      "keys": [
