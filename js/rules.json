      "admin",
      "\\b(drop|alter|grant|revoke)\\b"
    ],
    [
      "delete",
      "\\b(delete|truncate)\\b"
    ],
    [
      "update",
      "\\bupdate\\b"
    ],
    [
      "create",
      "\\binsert\\b"
    ],
    [
      "read",
      "^\\s*(select|show|explain|describe|with)\\b"
    ]
  ],
  "keyRules": [
    {
      "keys": [
        "page_id",
        "id"
      ],
      "type": "notion-page",
      "whenTool": "^notion-",
      "valueExtract": "([0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12})",
      "stripChars": "-"
    },
    {
      "keys": [
        "database_id",
        "data_source_id",
        "data_source_url"
      ],
      "type": "notion-database",
      "whenTool": "^notion-",
      "valueExtract": "([0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12})",
      "stripChars": "-"
    },
    {
